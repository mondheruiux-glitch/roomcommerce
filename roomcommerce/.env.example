# =============================================================================
# RoomCommerce — Environment Variables Template
#
# Copy to .env and fill in real values for local development.
# Docker Compose local stack credentials are pre-filled below.
# All MODAL_*, STRIPE_*, and affiliate vars default to mock/test mode.
# =============================================================================

# ── Server Runtime ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── Auth & Security Secrets ───────────────────────────────────────────────────
# Minimum 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=local_dev_super_secret_jwt_key_minimum_32_chars
COOKIE_SECRET=local_dev_cookie_signing_secret_32_chars

# ── PostgreSQL 16 (Local Docker: roomcommerce-postgres) ──────────────────────
# docker compose up -d postgres
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/roomcommerce

# ── Redis 7 (Local Docker: roomcommerce-redis) ───────────────────────────────
# docker compose up -d redis
REDIS_URL=redis://localhost:6379

# ── Qdrant Vector DB (Local Docker: roomcommerce-qdrant) ─────────────────────
# Web UI: http://localhost:6333/dashboard
# docker compose up -d qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Cloudflare R2 / MinIO (Local Docker: roomcommerce-r2-local) ──────────────
# MinIO Console: http://localhost:9001  (minioadmin / minioadmin_password)
# docker compose up -d r2-local r2-init
CLOUDFLARE_R2_ACCOUNT_ID=local
CLOUDFLARE_R2_ENDPOINT=http://localhost:9000
CLOUDFLARE_R2_ACCESS_KEY_ID=minioadmin
CLOUDFLARE_R2_SECRET_ACCESS_KEY=minioadmin_password
CLOUDFLARE_R2_BUCKET_NAME=roomcommerce-assets
CLOUDFLARE_R2_PUBLIC_URL=http://localhost:9000/roomcommerce-assets
# Legacy env var name (kept for API compatibility)
CLOUDFLARE_R2_PUBLIC_DOMAIN=http://localhost:9000/roomcommerce-assets

# ── Serverless GPU Pipeline (Mock Mode for Local & E2E) ──────────────────────
# Set MODAL_MOCK_MODE=true to run the deterministic 5-stage stub locally.
# After `modal deploy workers/gpu-runner/modal_app.py`, paste the endpoint URL.
MODAL_MOCK_MODE=true
MODAL_API_ENDPOINT=https://mock-gpu.modal.run/render
MODAL_API_TOKEN=mock_modal_token
MODAL_COST_WARN_USD=0.04

# ── Stripe Payment Processing ─────────────────────────────────────────────────
# Use sk_test_* locally. Switch to sk_live_* at production cutover.
STRIPE_SECRET_KEY=sk_test_mock_local_key
STRIPE_WEBHOOK_SECRET=whsec_mock_local_secret

# ── Affiliate & Partner APIs ──────────────────────────────────────────────────
# Amazon PA-API 5.0
AMAZON_PAAPI_ACCESS_KEY=your_amazon_paapi_access_key
AMAZON_PAAPI_SECRET_KEY=your_amazon_paapi_secret_key
AMAZON_PAAPI_PARTNER_TAG=roomcommerce-20
AMAZON_PAAPI_HOST=webservices.amazon.com
AMAZON_PAAPI_REGION=us-east-1

# Wayfair Supplier API
WAYFAIR_API_CLIENT_ID=your_wayfair_client_id
WAYFAIR_API_CLIENT_SECRET=your_wayfair_client_secret
WAYFAIR_SUPPLIER_ID=your_wayfair_supplier_id

# Target (Impact Radius) Affiliate
IMPACT_RADIUS_API_TOKEN=mock_target_token

# IKEA (CJ Affiliate) Partner
CJ_AFFILIATE_TOKEN=mock_ikea_token

# ── Telemetry — PostHog (optional) ───────────────────────────────────────────
# Leave blank to emit structured JSON logs only (no PostHog call made).
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ── Build Metadata (injected by ECS / CI at deploy time) ─────────────────────
APP_VERSION=1.0.0
