{
  "name": "roomcommerce",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "cloud:cutover": "bash scripts/cloud-cutover.sh",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:push": "pnpm --filter @roomcommerce/api run db:push",
    "local:bootstrap": "pnpm docker:up && pnpm db:push && pnpm api:seed && pnpm preflight",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:us01": "playwright test tests/e2e/us01-generation.spec.ts",
    "test:e2e:us02": "playwright test tests/e2e/us02-procurement.spec.ts",
    "test:e2e:us03": "playwright test tests/e2e/us03-anchor-locking.spec.ts",
    "test:chaos": "playwright test tests/e2e/chaos-fault-injection.spec.ts",
    "test:a11y": "playwright test tests/e2e/a11y-audit.spec.ts",
    "test:mobile": "playwright test tests/e2e/mobile-viewport.spec.ts --project=\"Mobile Safari (iPhone 15)\"",
    "test:load:burst": "k6 run tests/load/k6-burst-test.js",
    "test:load:vector": "k6 run tests/load/k6-vector-search-test.js",
    "test:load": "k6 run tests/load/k6-burst-test.js && k6 run tests/load/k6-vector-search-test.js",
    "test:ci": "playwright test && k6 run tests/load/k6-burst-test.js",
    "circuit-breaker:dry": "NODE_ENV=development ts-node apps/api/scripts/circuit-breaker-monitor.ts",
    "circuit-breaker:eval": "SINGLE_SHOT=true NODE_ENV=production ts-node apps/api/scripts/circuit-breaker-monitor.ts",
    "api:seed": "pnpm --filter @roomcommerce/api run catalog:seed",
    "api:embed": "pnpm --filter @roomcommerce/api run catalog:embed",
    "api:r2-lifecycle": "pnpm --filter @roomcommerce/api run r2:lifecycle",
    "api:circuit-breaker": "pnpm --filter @roomcommerce/api run circuit-breaker:eval",
    "preflight": "pnpm --filter @roomcommerce/api run preflight",
    "gpu:deploy": "python3 -m modal deploy workers/gpu-runner/modal_app.py",
    "infra:deploy-worker": "wrangler deploy --config infra/cloudflare/wrangler.toml",
    "infra:autoscaling": "bash infra/ecs/register-autoscaling.sh prod",
    "setup:tools": "bash scripts/setup-host-tools.sh",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "prettier": "^3.3.0",
    "turbo": "^2.2.0",
    "typescript": "^5.6.0",
    "wait-on": "^8.0.3"
  }
}
