{
  "name": "@roomcommerce/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./motion": {
      "import": {
        "types": "./dist/motion/index.d.ts",
        "default": "./dist/motion/index.js"
      },
      "require": {
        "types": "./dist/motion/index.d.cts",
        "default": "./dist/motion/index.cjs"
      }
    },
    "./react-bits": {
      "import": {
        "types": "./dist/react-bits/index.d.ts",
        "default": "./dist/react-bits/index.js"
      },
      "require": {
        "types": "./dist/react-bits/index.d.cts",
        "default": "./dist/react-bits/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/motion/index.ts src/react-bits/index.ts --format esm,cjs --dts --clean --external react --external react-dom",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests",
    "bits:add": "tsx scripts/add-bit.ts",
    "bits:list": "tsx scripts/add-bit.ts --list",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@roomcommerce/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.56.0",
    "motion": "^14.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.13.0",
    "@roomcommerce/config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
